{
  "name": "@sonparkserver/my-plugin-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test && sps-plugin validate . --json && sps-plugin test . --json",
    "test:browser": "node scripts/smoke-ui.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "files": ["dist/manifest.js", "dist/worker.js", "dist/ui-v0.1.0", "dist/third-party-notices", "THIRD_PARTY_NOTICES.md"],
  "spsPlugin": { "manifest": "./dist/manifest.js", "worker": "./dist/worker.js", "ui": "./dist/ui-v0.1.0" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sonparkserver/plugin-sdk": "github:Powerpunch777/sps-plugin-sdk#61a929f6c783f78e5af603682de1543c7e24abc0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.1",
    "lucide-react": "1.66.0"
  },
  "peerDependencies": { "react": "^19.2.7", "react-dom": "^19.2.7" }
}
